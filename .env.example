# 复制为 .env 后按需修改：cp .env.example .env
# 所有项都可以用环境变量覆盖（Docker 部署直接传环境变量即可）。

# ---- 基础 ----
APP_NAME=快传
PORT=7654
HOST=0.0.0.0
# 运行数据目录。默认在项目内；Docker 部署用 /data（需同时设 ALLOW_EXTERNAL_DATA_DIR=1）。
DATA_DIR=./data
# 允许 DATA_DIR 落在项目目录之外（仅 Docker 挂载卷时需要）
ALLOW_EXTERNAL_DATA_DIR=0

# ---- 有效期 ----
# 新建分享的默认有效期（小时）
DEFAULT_TTL_HOURS=24
# 页面上可选的最长有效期（小时）
MAX_TTL_HOURS=168
# 清理器扫描间隔（秒）
TTL_SWEEP_SECONDS=60

# ---- 容量限制 ----
# 上传到服务器时的单个文件上限（字节），默认 2GB；设为 0 表示不限制。
# 直接传输（不经过服务器）不受这一项约束，见 MAX_P2P_FILE_BYTES。
MAX_FILE_BYTES=2147483648
# 直接传输时的单个文件上限（字节），默认 0 表示不限制
MAX_P2P_FILE_BYTES=0
# 单个文本分享上限（字节），默认 1MB
MAX_TEXT_BYTES=1048576
# 暂存总量上限（字节），默认 20GB；设为 0 表示不限制。超出时按创建时间清理最旧的暂存分享。
MAX_TOTAL_BYTES=21474836480

# ---- P2P 与内存中继 ----
# 是否允许在 P2P 打洞失败时用服务器内存转发（全程不落盘）
RELAY_ENABLED=1
# 中继等待对端接入的秒数
RELAY_WAIT_SECONDS=120
# 同时进行的中继会话上限
RELAY_MAX_SESSIONS=8
# STUN 服务器，逗号分隔；留空表示只尝试内网直连
STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
# 打洞失败不用管：会自动改用服务器内存转发（全程不落盘），由上面的 RELAY_ENABLED 控制

# ---- 安全 ----
# 访问令牌签名密钥。留空则首次启动自动生成并保存到 <DATA_DIR>/secret.key
TOKEN_SECRET=
# access token 有效期（秒），默认 2 小时
ACCESS_TOKEN_TTL_SECONDS=7200
# owner token 有效期（秒），默认 30 天
OWNER_TOKEN_TTL_SECONDS=2592000

# ---- 日志 ----
LOG_LEVEL=info
# 留空只写 stdout；填相对路径则写到 <DATA_DIR>/logs/ 下
LOG_FILE=
